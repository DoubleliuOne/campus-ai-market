# Copy this file to .env in the project root before running Docker Compose.
# Compose now requires these secrets to be set explicitly.

MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_USER=campusai
MYSQL_PASSWORD=replace-with-a-strong-app-password
LOCAL_MYSQL_USERNAME=root
LOCAL_MYSQL_PASSWORD=replace-with-your-local-mysql-password
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
JWT_SECRET=replace-with-at-least-32-random-characters

# Optional: point the embedding model to local files mounted at ./.model-cache:/models:ro.
# Useful when hf-mirror.com is unreachable or returns empty downloads in the container.
# EMBEDDING_MODEL_URI=file:/models/model.onnx
# EMBEDDING_TOKENIZER_URI=file:/models/tokenizer.json
