# Copy this file to .env in the project root before running Docker Compose.
# Values marked "dev default" also work without a .env file.

MYSQL_ROOT_PASSWORD=campusai_root_dev_password
MYSQL_USER=campusai
MYSQL_PASSWORD=campusai_app_dev_password
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
JWT_SECRET=replace-with-at-least-32-random-characters

# Optional: point the embedding model to local files mounted at ./.model-cache:/models:ro.
# Useful when hf-mirror.com is unreachable or returns empty downloads in the container.
# EMBEDDING_MODEL_URI=file:/models/model.onnx
# EMBEDDING_TOKENIZER_URI=file:/models/tokenizer.json
